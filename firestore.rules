rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Galería, vídeos, fotos de "Sobre mí" ─────────────────────────────
    // Lectura pública · Escritura solo desde el panel admin (usuario autenticado)
    match /photos/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@andrealopezfoto.es';
    }
    match /videos/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@andrealopezfoto.es';
    }
    match /sobre_photos/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@andrealopezfoto.es';
    }

    // ── Configuración del sitio ───────────────────────────────────────────
    // Lectura pública (necesaria para cargar config en cada visita)
    // Escritura solo desde el panel admin (usuario autenticado)
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@andrealopezfoto.es';
    }

    // ── Carpetas (públicas para compartir vía QR) ───────────────────────────
    match /folders/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@andrealopezfoto.es';
    }

    // ── Bloquear cualquier otra colección por defecto ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
