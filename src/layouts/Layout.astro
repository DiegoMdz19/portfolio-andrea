---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { languages, ui, defaultLang } from '../i18n/ui';
const { title, lang = defaultLang } = Astro.props;
const translations = ui[lang as keyof typeof ui] || ui[defaultLang];
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
<meta charset="UTF-8">
<script is:inline define:vars={{ translations }}>
  window.t = function(key) {
    return translations[key] || key;
  };
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{title}</title>
<script is:inline>
if('scrollRestoration' in history) history.scrollRestoration = 'manual';
window.scrollTo(0,0);

// CSS dinámico: ocultar secciones + nav links (excepto mobile-menu que usa visibility)
function _buildSectionsCSS(stored){
  var ids = ['sobre','galeria','videos','servicios','proceso','testimonios','contacto'];
  var css = '';
  ids.forEach(function(id){
    if(stored[id]===false||stored[id]==='false'){
      css += '#'+id+'{display:none!important}';
      css += 'nav .nav-links a[href="#'+id+'"],#footer-nav a[href="#'+id+'"]{display:none!important}';
      css += '.mobile-menu a[href="#'+id+'"]{visibility:hidden!important;height:0!important;overflow:hidden!important;margin:0!important;padding:0!important;min-height:0!important;}';
    }
  });
  return css;
}

(function(){
  try{
    var stored = JSON.parse(localStorage.getItem('alr_sections')||'{}');
    var css = _buildSectionsCSS(stored);
    if(css){
      var st = document.createElement('style');
      st.id = '_sections-hide';
      st.textContent = css;
      document.head.appendChild(st);
    }
  }catch(e){}
})();

function _applySections(){
  window.scrollTo(0,0);
  var old = document.getElementById('_sections-hide');
  if(old) old.remove();
  try{
    var stored = JSON.parse(localStorage.getItem('alr_sections')||'{}');
    var css = _buildSectionsCSS(stored);
    if(css){
      var st = document.createElement('style');
      st.id = '_sections-hide';
      st.textContent = css;
      document.head.appendChild(st);
    }
  }catch(e){}
}
document.addEventListener('DOMContentLoaded', _applySections);
window.addEventListener('load', _applySections);
</script>
