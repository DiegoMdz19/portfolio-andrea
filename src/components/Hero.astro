---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<!-- HERO -->
<section id="hero">
  <div class="hero-video-wrap">
    <video autoplay muted loop playsinline>
      <source src="/videos/hero-prueba.mp4" type="video/mp4">
    </video>
  </div>
  <div class="hero-content">
    <div class="hero-left">
      <p class="hero-eyebrow">{t('loader.sub')}</p>
      <h1 class="hero-name">
        <span class="hero-name-line"><span class="hero-name-inner delay-1">{t('loader.name')}</span></span>
        <span class="hero-name-line"><span class="hero-name-inner delay-2"><em>{t('loader.lastname')}</em></span></span>
      </h1>
    </div>
    <div class="hero-right">
      <p class="hero-tagline">{t('hero.tagline')}</p>
      <a href="#galeria" class="hero-cta">{t('hero.cta')}</a>
    </div>
  </div>
  <div class="hero-scroll">
    <div class="scroll-line"></div>
    <span>{t('hero.scroll')}</span>
  </div>
</section>