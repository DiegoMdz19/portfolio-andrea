---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Layout title="Andrea López — Fotografía & Vídeo con Dron" lang={lang}>
  <div id="loader">
    <canvas id="loaderCanvas" style="position:absolute;inset:0;pointer-events:none;z-index:0;"></canvas>

    <!-- Marcos esquinas -->
    <div class="loader-corner loader-corner--tl"></div>
    <div class="loader-corner loader-corner--tr"></div>
    <div class="loader-corner loader-corner--bl"></div>
    <div class="loader-corner loader-corner--br"></div>

    <!-- Textos laterales -->
    <div class="loader-year">{t('loader.tags')}</div>
    <div class="loader-left-text">{t('loader.location')}</div>

    <!-- Contenido central -->
    <p class="loader-eyebrow" style="position:relative;z-index:1;">{t('loader.eyebrow')}</p>

    <div class="loader-svg-wrap" style="position:relative;z-index:1;">
      <svg width="140" height="94" viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg">
        <path class="loader-path-al" d="M8,68 L28,12 L48,68 M14,48 L42,48"/>
        <path class="loader-path-al" d="M62,12 L62,68 L96,68" style="stroke-dasharray:140;stroke-dashoffset:140;animation-delay:.9s"/>
        <circle class="loader-path-dot" cx="104" cy="65" r="2.5"/>
      </svg>
    </div>

    <p class="loader-name" style="position:relative;z-index:1;">{t('loader.name')} <em>{t('loader.lastname')}</em></p>
    <p class="loader-sub" style="position:relative;z-index:1;">{t('loader.sub')}</p>

    <div class="loader-bar-wrap" style="position:relative;z-index:1;"><div class="loader-bar"></div></div>
    <p class="loader-pct" id="loaderPct" style="position:relative;z-index:1;">0%</p>

    <button class="loader-enter" id="loaderEnterBtn" style="position:relative;z-index:1;">{t('loader.btn')}</button>

    <p class="loader-firma">andrealopezfoto.es</p>
  </div>

  <Navbar />

  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-inner">
      <a href="#sobre"       class="mobile-link">{t('nav.sobre')}</a>
      <a href="#galeria"     class="mobile-link">{t('nav.galeria')}</a>
      <a href="#videos"      class="mobile-link">{t('nav.videos')}</a>
      <a href="#servicios"   class="mobile-link">{t('nav.servicios')}</a>
      <a href="#proceso"     class="mobile-link">{t('nav.proceso')}</a>
      <a href="#testimonios" class="mobile-link">{t('nav.testimonios')}</a>
      <a href="#contacto"    class="mobile-link">{t('nav.contacto')}</a>
      <div class="mobile-menu-footer">
         <a href={`https://instagram.com/${t('social.instagram')}`} target="_blank" class="mobile-menu-social">Instagram</a>
      </div>
    </div>
  </div>

  <main>
    <Hero />

    <section id="sobre">
      <div class="sobre-inner">
        <div class="sobre-img-col reveal">
          <div class="sobre-carousel">
            <div class="sobre-carousel-track" id="sobreTrack">
               <div class="sobre-carousel-slide"><img src="/fotos/retrato.jpeg" alt="Andrea López" loading="lazy" /></div>
               <div class="sobre-carousel-slide"><img src="/fotos/drone1.jpg" alt="Andrea volando dron" loading="lazy" /></div>
               <div class="sobre-carousel-slide"><img src="/fotos/drone2.jpg" alt="Portfolio fotografía" loading="lazy" /></div>
            </div>
            <button class="sobre-carousel-btn sobre-prev" id="sobrePrev">‹</button>
            <button class="sobre-carousel-btn sobre-next" id="sobreNext">›</button>
            <div class="sobre-carousel-dots" id="sobreDots"></div>
          </div>
          <div class="sobre-accent-box"></div>
        </div>
        
        <div class="sobre-content-col">
          <p class="section-label reveal">{t('sobre.label')}</p>
          <h2 class="sobre-heading reveal">
            {t('sobre.heading1')}<br/>
            <em>{t('sobre.heading2')}</em>
          </h2>
          <div class="sobre-body reveal">
            <p>{t('sobre.p1')}</p>
            <p>{t('sobre.p2')}</p>
          </div>
          <a href="#contacto" class="social-link reveal">
            <span>{t('nav.contacto')}</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <section id="galeria">
      <div class="container">
        <div class="gallery-header reveal">
          <div class="gallery-info">
            <p class="section-label">{t('galeria.label')}</p>
            <h2 class="gallery-title">{t('galeria.heading1')} <em>{t('galeria.heading2')}</em></h2>
          </div>
          
          <div class="gallery-filter-wrap">
            <ul class="gallery-filter" id="galleryFilter">
              <li><button class="active" data-filter="all">{t('galeria.filterAll')}</button></li>
            </ul>
          </div>
        </div>

        <div class="gallery-search-wrap reveal">
          <input type="text" id="gallerySearch" placeholder={t('galeria.search')} />
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>

        <div class="gallery-grid" id="galleryGrid"></div>

        <div class="gallery-footer reveal">
          <div class="gallery-counter" id="galleryCounter"></div>
          <button class="gallery-load-more" id="loadMoreBtn">{t('galeria.loadMore')}</button>
        </div>
      </div>
    </section>

    <section id="videos">
      <div class="container">
        <p class="section-label reveal">{t('videos.label')}</p>
        <h2 class="gallery-title reveal" style="margin-bottom:60px;">{t('videos.title')} <em>{t('videos.subtitle')}</em></h2>
        
        <div class="video-grid" id="videoGrid"></div>
      </div>
    </section>

    <section id="servicios">
      <div class="container">
        <div class="servicios-header reveal">
          <h2 class="servicios-h">{t('servicios.heading1')}<br/><em>{t('servicios.heading2')}</em></h2>
          <a href="#contacto" class="btn-primary">{t('servicios.btn')}</a>
        </div>

        <div class="servicios-grid">
          <div class="servicio-card reveal">
            <span class="serv-num">01</span>
            <h3>{t('servicios.s1.n')}</h3>
            <p>{t('servicios.s1.d')}</p>
            <div class="serv-footer"><span class="serv-price">{t('servicios.desde')} <strong>{t('servicios.s1.p')}</strong></span></div>
          </div>
          <div class="servicio-card reveal">
            <span class="serv-num">02</span>
            <h3>{t('servicios.s2.n')}</h3>
            <p>{t('servicios.s2.d')}</p>
            <div class="serv-footer"><span class="serv-price">{t('servicios.desde')} <strong>{t('servicios.s2.p')}</strong></span></div>
          </div>
          <div class="servicio-card reveal">
            <span class="serv-num">03</span>
            <h3>{t('servicios.s3.n')}</h3>
            <p>{t('servicios.s3.d')}</p>
            <div class="serv-footer"><span class="serv-price">{t('servicios.desde')} <strong>{t('servicios.s3.p')}</strong></span></div>
          </div>
          <div class="servicio-card reveal">
            <span class="serv-num">04</span>
            <h3>{t('servicios.s4.n')}</h3>
            <p>{t('servicios.s4.d')}</p>
            <div class="serv-footer"><span class="serv-price">{t('servicios.desde')} <strong>{t('servicios.s4.p')}</strong></span></div>
          </div>
          <div class="servicio-card reveal">
            <span class="serv-num">05</span>
            <h3>{t('servicios.s5.n')}</h3>
            <p>{t('servicios.s5.d')}</p>
            <div class="serv-footer"><span class="serv-price">{t('servicios.desde')} <strong>{t('servicios.s5.p')}</strong></span></div>
          </div>
          <div class="servicio-card reveal">
            <span class="serv-num">06</span>
            <h3>{t('servicios.s6.n')}</h3>
            <p>{t('servicios.s6.d')}</p>
            <div class="serv-footer"></div>
          </div>
        </div>
      </div>
    </section>

    <section id="proceso">
      <div class="container">
        <div class="proceso-header reveal">
          <p class="section-label">{t('proceso.label')}</p>
          <h2 class="proceso-h">{t('proceso.heading1')} <em>{t('proceso.heading2')}</em></h2>
        </div>
        <div class="proceso-steps">
          <div class="proceso-step reveal">
            <div class="proceso-num">01</div>
            <h3 class="proceso-titulo">{t('proceso.p1.n')}</h3>
            <p class="proceso-desc">{t('proceso.p1.d')}</p>
          </div>
          <div class="proceso-step reveal">
            <div class="proceso-num">02</div>
            <h3 class="proceso-titulo">{t('proceso.p2.n')}</h3>
            <p class="proceso-desc">{t('proceso.p2.d')}</p>
          </div>
          <div class="proceso-step reveal">
            <div class="proceso-num">03</div>
            <h3 class="proceso-titulo">{t('proceso.p3.n')}</h3>
            <p class="proceso-desc">{t('proceso.p3.d')}</p>
          </div>
          <div class="proceso-step reveal">
            <div class="proceso-num">04</div>
            <h3 class="proceso-titulo">{t('proceso.p4.n')}</h3>
            <p class="proceso-desc">{t('proceso.p4.d')}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="testimonios">
      <div class="container">
        <p class="section-label reveal">{t('testimonio.label')}</p>
        <h2 class="testimonio-h reveal">{t('testimonio.heading1')}<br/><em>{t('testimonio.heading2')}</em></h2>
        <div class="testimonio-grid">
          <div class="testimonio-card reveal">
            <p class="test-text">{t('testimonio.t1.t')}</p>
            <div class="test-footer"><strong>{t('testimonio.t1.a')}</strong><span>{t('testimonio.t1.p')}</span></div>
          </div>
          <div class="testimonio-card reveal">
            <p class="test-text">{t('testimonio.t2.t')}</p>
            <div class="test-footer"><strong>{t('testimonio.t2.a')}</strong><span>{t('testimonio.t2.p')}</span></div>
          </div>
          <div class="testimonio-card reveal">
            <p class="test-text">{t('testimonio.t3.t')}</p>
            <div class="test-footer"><strong>{t('testimonio.t3.a')}</strong><span>{t('testimonio.t3.p')}</span></div>
          </div>
        </div>
      </div>
    </section>

    <section id="contacto">
      <div class="container">
        <div class="contacto-inner">
          <div class="contacto-content reveal">
            <p class="section-label">{t('nav.contacto')}</p>
            <h2 class="contacto-heading">{t('contacto.heading1')}<br/><em>{t('contacto.heading2')}</em></h2>
            <p class="contacto-body">{t('contacto.desc')}</p>
            <div class="contacto-info">
              <div class="contacto-info-item"><div class="info-dot"></div><span>{t('contacto.loc')}</span></div>
              <div class="contacto-info-item"><div class="info-dot"></div><a href={`mailto:${t('social.email')}`}>{t('social.email')}</a></div>
              <div class="contacto-info-item"><div class="info-dot"></div><a href={`https://instagram.com/${t('social.instagram')}`} target="_blank">@{t('social.instagram')}</a></div>
            </div>
          </div>
          <div class="contacto-form-col reveal">
            <form class="contacto-form" id="contactForm">
              <div class="form-row">
                <div class="form-group"><label>{t('contacto.form.name')}</label><input type="text" name="user_name" placeholder={t('loader.name')} required /></div>
                <div class="form-group"><label>{t('contacto.form.email')}</label><input type="email" name="user_email" placeholder={t('contacto.form.emailPlace')} required /></div>
              </div>
              <div class="form-group"><label>{t('contacto.form.type')}</label><input type="text" name="project_type" placeholder={t('contacto.form.typePlace')} /></div>
              <div class="form-group"><label>{t('contacto.form.msg')}</label><textarea name="message" rows="4" placeholder={t('contacto.form.msgPlace')} required></textarea></div>
              <button type="submit" class="btn-submit" id="contactSubmit"><span>{t('contacto.form.btn')}</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></button>
              <div id="contactStatus" class="contact-status"></div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang}/>

  <!-- MODALS Y OVERLAYS -->
  <div id="video-lightbox">
    <button class="vlb-close">✕</button>
    <div class="vlb-content">
      <video controls id="mainVideo"></video>
      <p class="vlb-title" id="vlbTitle"></p>
    </div>
  </div>

  <div id="album-view">
    <div class="album-container">
      <nav class="album-nav">
        <button class="album-back" id="albumBackBtn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
          {t('album.back')}
        </button>
        <div class="album-title-text" id="albumTitleText"></div>
        <button class="album-zip-btn" id="albumZipBtn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4m7-5 2 2 2-2m-2-4v6"/></svg>
          <span>{t('album.download')}</span>
        </button>
      </nav>
      <div id="album-zip-progress"></div>
      <div class="album-grid" id="albumGrid"></div>
    </div>
  </div>

  <div id="cookie-banner">
    <div class="cookie-text"><p set:html={t('cookie.text')} /></div>
    <div class="cookie-btns">
      <button class="cookie-btn" id="cookiesReject">{t('cookie.reject')}</button>
      <button class="cookie-btn primary" id="cookiesAccept">{t('cookie.accept')}</button>
    </div>
  </div>

  <div id="custom-modal">
    <div class="modal-box">
      <div class="modal-icon" id="modal-icon">⚠</div>
      <h3 id="modal-title"></h3>
      <p id="modal-msg"></p>
      <div class="modal-btns" id="modal-btns"></div>
    </div>
  </div>

  <div id="qr-modal" class="qrm-overlay">
    <div class="qrm-box">
      <button class="qrm-close">✕</button>
      <p class="qrm-label">{t('admin.qrLabel')}</p>
      <div id="qrCodeContainer" class="qrm-canvas"></div>
      <div class="qrm-links">
        <button class="qrm-btn" id="qrCopyLink">{t('admin.copy')}</button>
        <a href="#" class="qrm-btn primary" id="qrDownloadBtn" download="qr-code.png">{t('admin.downloadQR')}</a>
      </div>
    </div>
  </div>

  <div id="admin-overlay">
    <div class="admin-wrap">
      <header class="admin-header">
        <div class="admin-user-info">
          <div class="admin-avatar">A</div>
          <div><h2 id="adminTitle">Admin Panel</h2><p id="adminStatus">andrealopezfoto.es</p></div>
        </div>
        <div class="admin-actions"><button class="admin-logout" id="logoutBtn">Logout</button><button class="admin-close" id="closeAdmin">✕</button></div>
      </header>
      <div class="admin-tabs">
        <button class="admin-tab active" data-tab="content">Contenido</button>
        <button class="admin-tab" data-tab="images">Imágenes</button>
        <button class="admin-tab" data-tab="videos">Vídeos</button>
        <button class="admin-tab" data-tab="stats">Stats</button>
        <button class="admin-tab" data-tab="settings">Ajustes</button>
      </div>
      <div class="admin-content-wrap"></div>
    </div>
  </div>

  <section id="privacy-section">
    <div class="privacy-wrap">
      <button class="privacy-close">✕</button>
      <div class="privacy-content">
        <p class="section-label">{t('footer.privacy')}</p>
        <h1>{t('privacy.title')}</h1>
        <p class="privacy-date">{t('privacy.update')}</p>
        <div class="privacy-block"><h3>{t('privacy.responsible')}</h3><p>Andrea López (andrealopezfoto.es)</p></div>
        <div class="privacy-block"><h3>{t('privacy.s1')}</h3><p>{t('privacy.p1')}</p></div>
        <div class="privacy-block"><h3>{t('privacy.s2')}</h3><p>{t('privacy.p2')}</p></div>
        <div class="privacy-block"><h3>{t('privacy.s3')}</h3><p>{t('privacy.p3')}</p></div>
        <div class="privacy-block"><h3>{t('privacy.s4')}</h3><p>{t('privacy.p4')}</p></div>
        <div class="privacy-block"><h3>{t('privacy.s5')}</h3><p>{t('privacy.p5')}</p></div>
      </div>
    </div>
  </section>

  <button class="whatsapp-btn" id="waBtn">
    <div class="wa-badge">1</div>
    <svg viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" /></svg>
    <div class="wa-popup">{t('wa.popup')}</div>
  </button>

  <div class="sound-btn" id="soundBtn"><div class="sound-bars"><span></span><span></span><span></span><span></span></div></div>
</Layout>
