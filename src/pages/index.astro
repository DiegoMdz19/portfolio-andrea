---
import Layout from '../layouts/Layout.astro';

import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Layout title="Andrea López — Fotografía & Vídeo con Dron" lang={lang}>
<div id="loader">
  <canvas id="loaderCanvas" style="position:absolute;inset:0;pointer-events:none;z-index:0;"></canvas>

  <!-- Marcos esquinas -->
  <div class="loader-corner loader-corner--tl"></div>
  <div class="loader-corner loader-corner--tr"></div>
  <div class="loader-corner loader-corner--bl"></div>
  <div class="loader-corner loader-corner--br"></div>

  <!-- Textos laterales -->
  <div class="loader-year">{t('loader.tags')}</div>
  <div class="loader-left-text">{t('loader.location')}</div>

  <!-- Contenido central -->
  <p class="loader-eyebrow" style="position:relative;z-index:1;">{t('loader.eyebrow')}</p>

  <div class="loader-svg-wrap" style="position:relative;z-index:1;">
    <svg width="140" height="94" viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg">
      <path class="loader-path-al" d="M8,68 L28,12 L48,68 M14,48 L42,48"/>
      <path class="loader-path-al" d="M62,12 L62,68 L96,68" style="stroke-dasharray:140;stroke-dashoffset:140;animation-delay:.9s"/>
      <circle class="loader-path-dot" cx="104" cy="65" r="2.5"/>
    </svg>
  </div>

  <p class="loader-name" style="position:relative;z-index:1;">{t('loader.name')} <em>{t('loader.lastname')}</em></p>
  <p class="loader-sub" style="position:relative;z-index:1;">{t('loader.sub')}</p>

  <div class="loader-bar-wrap" style="position:relative;z-index:1;"><div class="loader-bar"></div></div>
  <p class="loader-pct" id="loaderPct" style="position:relative;z-index:1;">0%</p>

  <button class="loader-enter" id="loaderEnterBtn" style="position:relative;z-index:1;">{t('loader.btn')}</button>

  <p class="loader-firma">andrealopezfoto.es</p>
</div>

<!-- CURSOR -->
<canvas id="trail-canvas"></canvas>
<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>
<div class="cursor-label" id="cursorLabel"></div>

<Navbar />

<!-- MENÚ MÓVIL -->
<div class="mobile-menu" id="mobileMenu">
  <a href="#sobre"       class="mobile-link">{t('nav.sobre')}</a>
  <a href="#galeria"     class="mobile-link">{t('nav.galeria')}</a>
  <a href="#videos"      class="mobile-link">{t('nav.videos')}</a>
  <a href="#servicios"   class="mobile-link">{t('nav.servicios')}</a>
  <a href="#proceso"     class="mobile-link">{t('nav.proceso')}</a>
  <a href="#testimonios" class="mobile-link">{t('nav.testimonios')}</a>
  <a href="#contacto"    class="mobile-link">{t('nav.contacto')}</a>
  <a href={`https://instagram.com/${t('social.instagram')}`} target="_blank" class="mobile-menu-social">{t('social.instagram')}</a>
</div>

<Hero />

<!-- SOBRE MÍ -->
<section id="sobre">
  <div class="sobre-img-col reveal">
    <div class="sobre-carousel" id="sobreCarousel">
      <div class="sobre-carousel-track" id="sobreTrack">
        <div class="sobre-carousel-slide active"><img src="fotos/retrato.jpeg" alt="Andrea López"></div>
      </div>
      <button class="sobre-carousel-btn sobre-prev" id="sobrePrev" aria-label="Anterior">&#8592;</button>
      <button class="sobre-carousel-btn sobre-next" id="sobreNext" aria-label="Siguiente">&#8594;</button>
      <div class="sobre-carousel-dots" id="sobreDots"></div>
    </div>
    <div class="sobre-accent-box"></div>
  </div>
  <div class="sobre-text-col">
    <div class="section-label reveal">{t('sobre.label')}</div>
    <h2 class="sobre-heading reveal reveal-delay-1">{t('sobre.heading1')}<br><em>{t('sobre.heading2')}</em></h2>
    <p class="sobre-body reveal reveal-delay-2">{t('sobre.p1')}</p>
    <p class="sobre-body reveal reveal-delay-2">{t('sobre.p2')}</p>
    <a href={`https://instagram.com/${t('social.instagram')}`} target="_blank" class="social-link reveal reveal-delay-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>{t('social.instagram')}</a>
  </div>
</section>

<!-- GALERÍA -->
<section id="galeria">
  <div class="section-label reveal">{t('galeria.label')}</div>
  <div class="gallery-header">
    <h2 class="gallery-title reveal reveal-delay-1">{t('galeria.heading1')}<br><em>{t('galeria.heading2')}</em></h2>
    <div class="gallery-controls reveal reveal-delay-2">
      <ul class="gallery-filter" id="galleryFilter">
        <li><button class="active" data-filter="all">{t('galeria.filterAll')}</button></li>
      </ul>
      <div class="gallery-search-wrap">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="gallerySearch" placeholder={t('galeria.search')} oninput="onGallerySearch(this.value)" autocomplete="off">
      </div>
    </div>
  </div>
  <div class="gallery-grid" id="galleryGrid" data-t-empty={t('galeria.noPhotos')} data-t-loading={t('galeria.loading')}></div>


  <div class="gallery-footer" id="galleryFooter" style="display:none;">
    <span id="galleryCounter" class="gallery-counter" data-t-showing={t('galeria.showing')}></span>
    <button class="gallery-load-more" id="galleryLoadMore" onclick="loadMorePhotos()">{t('galeria.loadMore')}</button>
  </div>
</section>

<!-- VÍDEOS -->
<section id="videos">
  <div class="section-label reveal">{t('nav.videos')}</div>
  <h2 class="video-heading reveal reveal-delay-1">{t('videos.heading1')}<br><em>{t('videos.heading2')}</em></h2>
    <!-- Cargado dinámicamente desde Firestore -->
    <div id="video-empty-msg" style="display:none;grid-column:1/-1;text-align:center;padding:40px;color:rgba(200,184,154,.4);font-size:.7rem;">
      {t('galeria.noPhotos')}
    </div>
  </div>

</section>

<!-- SERVICIOS -->
<section id="servicios">
  <div class="section-label reveal">{t('nav.servicios')}</div>
  <h2 class="video-heading reveal reveal-delay-1">{t('servicios.heading1')}<br><em>{t('servicios.heading2')}</em></h2>
  <div class="servicios-grid">
    <div class="servicio-card reveal">
      <div class="servicio-icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" width="28" height="28"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg></div>
      <h3 class="servicio-nombre">{t('servicios.s1.n')}</h3>
      <p class="servicio-desc">{t('servicios.s1.d')}</p>
      <div class="servicio-precio"><span class="servicio-desde">{t('servicios.desde')}</span>{t('servicios.s1.p')}</div>
    </div>
    <div class="servicio-card reveal reveal-delay-1">
      <div class="servicio-icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" width="28" height="28"><circle cx="12" cy="12" r="3"/><line x1="3" y1="3" x2="7" y2="7"/><line x1="17" y1="7" x2="21" y2="3"/><line x1="7" y1="17" x2="3" y2="21"/><line x1="17" y1="17" x2="21" y2="21"/></svg></div>
      <h3 class="servicio-nombre">{t('servicios.s2.n')}</h3>
      <p class="servicio-desc">{t('servicios.s2.d')}</p>
      <div class="servicio-precio"><span class="servicio-desde">{t('servicios.desde')}</span>{t('servicios.s2.p')}</div>
    </div>
    <div class="servicio-card reveal reveal-delay-2">
      <div class="servicio-icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" width="28" height="28"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M7 2v20"/><path d="M17 2v20"/><path d="M2 12h5"/><path d="M17 12h5"/></svg></div>
      <h3 class="servicio-nombre">{t('servicios.s3.n')}</h3>
      <p class="servicio-desc">{t('servicios.s3.d')}</p>
      <div class="servicio-precio"><span class="servicio-desde">{t('servicios.desde')}</span>{t('servicios.s3.p')}</div>
    </div>
    <div class="servicio-card reveal">
      <div class="servicio-icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" width="28" height="28"><circle cx="12" cy="12" r="5"/><path d="M12 7V3"/><path d="M7.05 9.95 4.22 7.22"/><path d="M5 12H1"/><path d="M7.05 14.05 4.22 16.78"/><path d="M12 17v4"/><path d="M16.95 14.05l2.83 2.73"/><path d="M19 12h4"/><path d="M16.95 9.95l2.83-2.73"/></svg></div>
      <h3 class="servicio-nombre">{t('servicios.s4.n')}</h3>
      <p class="servicio-desc">{t('servicios.s4.d')}</p>
      <div class="servicio-precio"><span class="servicio-desde">{t('servicios.desde')}</span>{t('servicios.s4.p')}</div>
    </div>
    <div class="servicio-card reveal reveal-delay-1">
      <div class="servicio-icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" width="28" height="28"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
      <h3 class="servicio-nombre">{t('servicios.s5.n')}</h3>
      <p class="servicio-desc">{t('servicios.s5.d')}</p>
      <div class="servicio-precio"><span class="servicio-desde">{t('servicios.desde')}</span>{t('servicios.s5.p')}</div>
    </div>
    <div class="servicio-card reveal reveal-delay-2">
      <div class="servicio-icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" width="28" height="28"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
      <h3 class="servicio-nombre">{t('servicios.s6.n')}</h3>
      <p class="servicio-desc">{t('servicios.s6.d')}</p>
      <div class="servicio-precio"><a href="#contacto" style="color:var(--warm);text-decoration:none;font-size:.7rem;letter-spacing:.15em;text-transform:uppercase;">{t('servicios.btn')}</a></div>
    </div>
  </div>
</section>

<!-- PROCESO -->
<section id="proceso">
  <div class="section-label reveal" style="color:rgba(200,184,154,.55);">{t('proceso.label')}</div>
  <h2 class="video-heading reveal reveal-delay-1" style="color:#f0ece4;">{t('proceso.heading1')}<br><em style="color:rgba(200,184,154,.7);">{t('proceso.heading2')}</em></h2>
  <div class="proceso-steps">
    <div class="proceso-step reveal">
      <div class="proceso-num">01</div>
      <h3 class="proceso-titulo">{t('proceso.p1.n')}</h3>
      <p class="proceso-desc">{t('proceso.p1.d')}</p>
    </div>
    <div class="proceso-step reveal reveal-delay-1">
      <div class="proceso-num">02</div>
      <h3 class="proceso-titulo">{t('proceso.p2.n')}</h3>
      <p class="proceso-desc">{t('proceso.p2.d')}</p>
    </div>
    <div class="proceso-step reveal reveal-delay-2">
      <div class="proceso-num">03</div>
      <h3 class="proceso-titulo">{t('proceso.p3.n')}</h3>
      <p class="proceso-desc">{t('proceso.p3.d')}</p>
    </div>
    <div class="proceso-step reveal reveal-delay-2">
      <div class="proceso-num">04</div>
      <h3 class="proceso-titulo">{t('proceso.p4.n')}</h3>
      <p class="proceso-desc">{t('proceso.p4.d')}</p>
    </div>
  </div>
</section>

<!-- TESTIMONIOS -->
<section id="testimonios">
  <div class="section-label reveal" style="color:rgba(200,184,154,.55);">{t('testimonio.label')}</div>
  <h2 class="video-heading reveal reveal-delay-1" style="color:#f0ece4;">{t('testimonio.heading1')}<br><em style="color:rgba(200,184,154,.7);">{t('testimonio.heading2')}</em></h2>
  <div class="testimonios-grid">
    <div class="testimonio-card reveal">
      <span class="testimonio-comilla">"</span>
      <p class="testimonio-texto">{t('testimonio.t1.t')}</p>
      <p class="testimonio-autor">{t('testimonio.t1.a')}</p>
      <span class="testimonio-proyecto">{t('testimonio.t1.p')}</span>
    </div>
    <div class="testimonio-card reveal reveal-delay-1">
      <span class="testimonio-comilla">"</span>
      <p class="testimonio-texto">{t('testimonio.t2.t')}</p>
      <p class="testimonio-autor">{t('testimonio.t2.a')}</p>
      <span class="testimonio-proyecto">{t('testimonio.t2.p')}</span>
    </div>
    <div class="testimonio-card reveal reveal-delay-2">
      <span class="testimonio-comilla">"</span>
      <p class="testimonio-texto">{t('testimonio.t3.t')}</p>
      <p class="testimonio-autor">{t('testimonio.t3.a')}</p>
      <span class="testimonio-proyecto">{t('testimonio.t3.p')}</span>
    </div>
  </div>
</section>

<!-- CONTACTO -->
<section id="contacto">
  <div class="contacto-inner">
    <div>
      <div class="section-label reveal">{t('nav.contacto')}</div>
      <h2 class="contacto-heading reveal reveal-delay-1">{t('contacto.heading1')}<br><em>{t('contacto.heading2')}</em></h2>
      <p class="contacto-body reveal reveal-delay-2">{t('contacto.desc')}</p>
      <div class="contacto-info reveal reveal-delay-3">
        <div class="contacto-info-item"><div class="info-dot"></div><a href={`https://instagram.com/${t('social.instagram')}`} target="_blank" style="display:inline-flex;align-items:center;gap:8px;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>{t('social.instagram')}</a></div>
        <div class="contacto-info-item"><div class="info-dot"></div><span>{t('contacto.loc')}</span></div>
      </div>
    </div>
    <form class="contacto-form reveal reveal-delay-2" onsubmit="handleSubmit(event)">
      <div class="form-row">
        <div class="form-group"><label>{t('contacto.form.name')}</label><input type="text" name="from_name" placeholder={t('contacto.form.name')} required></div>
        <div class="form-group"><label>{t('contacto.form.email')}</label><input type="email" name="reply_to" placeholder={t('contacto.form.emailPlace')} required></div>
      </div>
      <div class="form-group"><label>{t('contacto.form.type')}</label><input type="text" name="proyecto" placeholder={t('contacto.form.typePlace')}></div>
      <div class="form-group"><label>{t('contacto.form.msg')}</label><textarea rows="5" name="message" placeholder={t('contacto.form.msgPlace')}></textarea></div>
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
      <button type="submit" class="btn-submit" 
        data-t-sending={t('contacto.form.sending')}
        data-t-success={t('contacto.form.success')}
        data-t-error={t('contacto.form.error')}
        data-t-default={t('contacto.form.btn')}>
        {t('contacto.form.btn')} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>
    </form>
  </div>
</section>

<!-- VISTA ÁLBUM (se activa con ?album=TOKEN) -->
<div id="album-view">
  <nav class="album-nav">
    <button class="album-back" onclick="closeAlbumView()">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      {t('album.back')}
    </button>
    <span id="album-title-text" class="album-title-text"></span>
    <button id="albumDownloadBtn" class="album-zip-btn" onclick="downloadAlbumZip()" style="display:none;">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      {t('album.download')}
    </button>
  </nav>
  <div id="album-zip-progress" style="display:none;">
    <div class="album-zip-bar"><div class="album-zip-fill" id="albumZipFill"></div></div>
    <span id="albumZipText" class="album-zip-text">{t('album.preparing')}</span>
  </div>
  <div id="album-grid" class="gallery-grid"></div>
  <p id="album-empty" style="display:none;text-align:center;padding:80px 24px;font-size:.82rem;color:#7a7068;font-weight:200;">{t('album.empty')}</p>
</div>

<Footer />

<!-- LIGHTBOX VÍDEO CARRUSEL -->
<div id="video-lightbox" style="position:fixed;inset:0;z-index:6000;background:rgba(4,3,2,.97);display:none;flex-direction:column;align-items:center;justify-content:center;opacity:0;transition:opacity .4s;">
  <button class="vlb-close" id="vlbClose">✕</button>
  <div style="position:relative;width:100vw;height:82vh;overflow:hidden;display:flex;align-items:center;">
    <div id="vlbTrack" style="display:flex;align-items:center;transition:transform .55s cubic-bezier(.86,0,.07,1);will-change:transform;"></div>
    <div style="position:absolute;top:50%;transform:translateY(-50%);display:flex;justify-content:space-between;width:100%;padding:0 28px;pointer-events:none;z-index:10;">
      <button class="lightbox-btn" id="vlbPrev" style="pointer-events:all;">&#8592;</button>
      <button class="lightbox-btn" id="vlbNext" style="pointer-events:all;">&#8594;</button>
    </div>
  </div>
  <div id="vlbCounter" style="margin-top:16px;font-size:.58rem;letter-spacing:.28em;text-transform:uppercase;color:rgba(240,236,228,.3);font-weight:300;"></div>
  <div id="vlbThumbStrip" style="display:flex;gap:6px;margin-top:12px;overflow-x:auto;max-width:80vw;padding:4px;scrollbar-width:none;"></div>
</div>

<!-- LIGHTBOX CARRUSEL NETFLIX -->
<div class="lightbox" id="lightbox">
  <button class="lightbox-close" id="lightboxClose" aria-label="Cerrar galería">✕</button>
  <button class="lightbox-slideshow-btn" id="slideshowBtn">{t('lightbox.slideshow')}</button>
  <div class="lightbox-track-wrap">
    <div class="lightbox-track" id="lightboxTrack"></div>
    <div class="lightbox-nav">
    <button class="lightbox-btn" id="lightboxPrev" aria-label="Foto anterior">&#8592;</button>
      <button class="lightbox-btn" id="lightboxNext" aria-label="Foto siguiente">&#8594;</button>
    </div>
    <div class="lightbox-watermark" id="lightboxWatermark">© Andrea López</div>
    <button class="lightbox-exif-btn" id="lightboxExifBtn" title="Datos técnicos" onclick="toggleExifPanel()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="12" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
    </button>
    <div class="lightbox-exif-panel" id="lightboxExifPanel"></div>
  </div>
  <div class="slideshow-progress" id="slideshowProgress"></div>
  <div class="lightbox-counter" id="lightboxCounter"></div>
  <div class="lightbox-thumb-strip" id="thumbStrip"></div>
</div>

<!-- WHATSAPP POPUP -->
<div class="whatsapp-popup" id="whatsappPopup">
  <button class="whatsapp-popup-close" onclick="closeWaPopup()">✕</button>
  <p>{t('wa.popup')}</p>
  <a id="whatsappPopupLink" href="https://wa.me/34600000000?text=Hola%20Andrea%2C%20me%20gustar%C3%ADa%20hablar%20sobre%20un%20proyecto" target="_blank" rel="noopener">{t('wa.btn')}</a>
</div>

<!-- BOTÓN WHATSAPP FLOTANTE -->
<a class="whatsapp-btn" id="whatsappBtn" href="https://wa.me/34600000000?text=Hola%20Andrea%2C%20me%20gustar%C3%ADa%20hablar%20sobre%20un%20proyecto" target="_blank" rel="noopener" aria-label="Escríbeme por WhatsApp">
